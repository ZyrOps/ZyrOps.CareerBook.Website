# Public site URL used for canonical URLs, sitemap, Open Graph and schema markup
NEXT_PUBLIC_SITE_URL=https://www.careerbookerp.com

# Google Analytics 4 measurement ID (GA loads only when set)
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML-tag verification token (content value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Contact details shown on the site
NEXT_PUBLIC_CONTACT_EMAIL=sales@careerbookerp.com
NEXT_PUBLIC_CONTACT_PHONE=+91 00000 00000
# WhatsApp number in international format, digits only (e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=910000000000

# CRM integration: lead form submissions are POSTed as JSON to this URL
# (HubSpot / Zoho / Salesforce / LeadSquared webhook, Zapier, Make, n8n, etc.)
CRM_WEBHOOK_URL=
# Optional bearer token sent as the Authorization header
CRM_WEBHOOK_TOKEN=
